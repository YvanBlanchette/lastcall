# Base de données
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lastcall?schema=public"

# Session (générer avec: openssl rand -base64 32)
AUTH_SECRET="changez-cette-valeur-en-production"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="lastcall_unsigned"

# Courriel (Resend, Postmark, SMTP… — voir src/lib/mail.js)
MAIL_FROM="LastCall <notifications@lastcall.ca>"
RESEND_API_KEY=""

# Protection des routes cron (Vercel Cron ou autre)
CRON_SECRET="changez-cette-valeur"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
